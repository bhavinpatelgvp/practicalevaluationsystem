# Streamlit Community Cloud Secrets Template
# -------------------------------------------------------------
# On Streamlit Community Cloud:
# 1. Open your App Dashboard → click "⋮" menu → "Settings" → "Secrets"
# 2. Copy everything below, fill in your real values, and Save.
#
# For Local Development:
# Copy this file to `.streamlit/secrets.toml` (already gitignored) and fill in values.
# OR set the same keys as environment variables in a `.env` file (also gitignored).
# -------------------------------------------------------------

# ── Administrator bootstrap credentials ──────────────────────────────────────
# Used by seed.py to create the first admin account on a fresh database.
# Change these to your real institutional credentials before deploying.
[admin]
email    = "admin@gujaratvidyapith.org"
password = "ChangeThisToAStrongPassword@2025"

# ── Application security ──────────────────────────────────────────────────────
SECRET_KEY = "replace-with-a-long-random-string-min-32-chars"

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — Streamlit Cloud resets on redeploy, seed.py handles re-init)
DATABASE_URL = "sqlite:///tpems.db"

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES = 60

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# From: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID     = "your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-client-secret"

# For local dev use http://localhost:8501
# For Streamlit Cloud use your live URL, e.g. https://your-app.streamlit.app
GOOGLE_REDIRECT_URI = "http://localhost:8501"

# Restrict sign-in to this domain only
GOOGLE_HOSTED_DOMAIN = "gujaratvidyapith.org"

# ── SMTP Email (optional — for password reset emails) ────────────────────────
SMTP_HOST     = "smtp.gmail.com"
SMTP_PORT     = 587
SMTP_USER     = "your-email@gujaratvidyapith.org"
SMTP_PASSWORD = "your-gmail-app-password"
MAIL_FROM     = "your-email@gujaratvidyapith.org"
