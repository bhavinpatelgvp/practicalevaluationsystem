# Streamlit Community Cloud Secrets Template
# -------------------------------------------------------------
# On Streamlit Community Cloud:
# 1. Open your App Dashboard -> Click "..." menu -> "Settings" -> "Secrets"
# 2. Copy and paste the configuration below and fill in your values.
# 3. Save your secrets.
#
# For Local Development:
# You can copy this file to `.streamlit/secrets.toml` and set your credentials.
# -------------------------------------------------------------

SECRET_KEY = "your-secure-production-secret-key-change-this"
DATABASE_URL = "sqlite:///tpems.db"

# Session Timeout (in minutes)
SESSION_TIMEOUT_MINUTES = 60

# Google OAuth 2.0 Credentials
# (From Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID = "your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-google-client-secret"

# IMPORTANT FOR DEPLOYMENT:
# In Streamlit Cloud, set GOOGLE_REDIRECT_URI to your live app URL, e.g.:
# GOOGLE_REDIRECT_URI = "https://your-app-name.streamlit.app"
GOOGLE_REDIRECT_URI = "http://localhost:8501"

# Institutional Domain Restriction (e.g. gujaratvidyapith.org)
GOOGLE_HOSTED_DOMAIN = "gujaratvidyapith.org"

# Optional SMTP Email Configuration (for password reset emails)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-email@gujaratvidyapith.org"
SMTP_PASSWORD = "your-gmail-app-password"
MAIL_FROM = "your-email@gujaratvidyapith.org"
